<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Preview kamera -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Logo Watermark -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:alpha="0.2"
        android:gravity="center"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KR AI"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- AI Focus Box Overlay -->
    <View
        android:id="@+id/aiFocusBox"
        android:layout_width="192dp"
        android:layout_height="192dp"
        android:background="@drawable/bg_ai_focus_box"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
        
    <!-- Face Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_ai_label"
        android:text="AI Human Detected 98%"
        android:textColor="#000000"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        app:layout_constraintBottom_toTopOf="@id/aiFocusBox"
        app:layout_constraintStart_toStartOf="@id/aiFocusBox" />

    <!-- AI hint -->
    <TextView
        android:id="@+id/aiHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI Ready"
        android:textColor="#E6FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:drawableStart="@drawable/ic_cyan_dot"
        android:drawablePadding="8dp"
        android:background="@drawable/bg_ai_hint"
        android:layout_margin="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Switch camera -->
    <ImageButton
        android:id="@+id/btnSwitchCamera"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="24dp"
        android:background="@drawable/bg_switch_camera"
        android:src="@drawable/ic_switch_camera"
        android:padding="12dp"
        android:scaleType="fitCenter"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Flash button -->
    <ImageButton
        android:id="@+id/btnFlash"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_switch_camera"
        android:src="@drawable/ic_flash_off"
        android:padding="12dp"
        android:scaleType="fitCenter"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="@id/btnSwitchCamera"
        app:layout_constraintBottom_toBottomOf="@id/btnSwitchCamera"
        app:layout_constraintEnd_toStartOf="@id/btnSwitchCamera" />

    <!-- Camera Mode Selector -->
    <LinearLayout
        android:id="@+id/cameraModes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/bottomControlCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvModeVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIDEO"
            android:textColor="#66FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:paddingHorizontal="16dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="16dp">
            
            <TextView
                android:id="@+id/tvModePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PHOTO"
                android:textColor="#22D3EE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <View
                android:id="@+id/dotModePhoto"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/ic_cyan_dot" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvModePortrait"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PORTRAIT"
            android:textColor="#66FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:paddingHorizontal="16dp" />
    </LinearLayout>

    <!-- Bottom control -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomControlCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        app:cardBackgroundColor="#99000000"
        app:cardCornerRadius="40dp"
        app:strokeWidth="1dp"
        app:strokeColor="#1AFFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageButton
                android:id="@+id/btnGallery"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_gallery_button"
                android:src="@drawable/ic_gallery"
                android:padding="14dp"
                android:scaleType="fitCenter"
                app:tint="#99FFFFFF" />

            <ImageButton
                android:id="@+id/btnCapture"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginHorizontal="32dp"
                android:background="@drawable/circle_button_bg"
                android:src="@drawable/ic_camera"
                android:scaleType="center" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_ai_button"
                android:src="@drawable/ic_settings"
                android:padding="12dp"
                android:scaleType="fitCenter"
                app:tint="#22D3EE" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
